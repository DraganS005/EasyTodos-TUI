Screen {
    background: $surface;
    color: $text;
}

/* -- header --------------------------------------------------------------- */

#app-header {
    height: 1;
    padding: 0 1;
    background: $primary;
    color: auto 90%;
}

#app-header Static {
    height: 1;
    padding: 0;
    background: transparent;
}

#app-title {
    width: auto;
    text-style: bold;
}

#app-stats {
    width: 1fr;
    text-align: right;
    color: auto 70%;
}

/* -- view tabs ------------------------------------------------------------ */

#views {
    height: 1;
    background: $panel;
}

#views Underline {
    display: none;
}

#views #tabs-list-bar {
    height: 1;
}

#views Tab {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    background: transparent;
    pointer: pointer;
}

#views Tab:hover {
    background: $boost;
}

#views Tab.-active {
    color: auto 90%;
    background: $accent;
    text-style: bold;
}

#view-bar {
    display: none;
    height: 1;
    padding: 0 1;
    background: $panel;
}

#view-bar .view-arrow {
    width: 1;
    height: 1;
    padding: 0;
    background: $primary-darken-2;
    color: auto 90%;
    text-align: center;
    content-align: center middle;
    text-wrap: nowrap;
    pointer: pointer;
}

#view-bar .view-arrow:hover {
    background: $accent;
    color: auto 90%;
}

#view-name {
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: $text;
    text-style: bold;
    text-align: center;
    content-align: center middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#view-bar-tail {
    width: 1;
    height: 1;
    background: transparent;
}

.-viewbar #views {
    display: none;
}

.-viewbar #view-bar {
    display: block;
}

/* -- list ----------------------------------------------------------------- */

#todo-list {
    height: 1fr;
    padding: 0;
    background: $surface;
    scrollbar-size-vertical: 1;
}

.todo-row {
    width: 100%;
    height: 1;
    padding: 0 1;
    color: $text;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    pointer: pointer;
}

.todo-row:hover {
    background: $boost;
}

.todo-row.-done {
    color: $text-muted;
    text-style: strike;
}

.todo-row.-selected {
    background: $block-cursor-background;
    color: $block-cursor-foreground;
    text-style: $block-cursor-text-style;
}

.todo-row.-selected.-done {
    color: $block-cursor-foreground;
}

.group-header {
    width: 100%;
    height: 1;
    margin-top: 1;
    padding: 0 1;
    color: $text-muted;
    background: $panel;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    pointer: pointer;
}

.group-header.-first {
    margin-top: 0;
}

.group-header:hover {
    background: $boost;
}

.empty-state {
    width: 100%;
    height: 100%;
    padding: 0 1;
    color: $text-muted;
    content-align: center middle;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* -- bottom chrome -------------------------------------------------------- */

#status {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    background: $surface;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#status.-error {
    color: $error;
}

#actions {
    height: 1;
    padding: 0 1;
    background: $panel;
}

#actions Button {
    height: 1;
    min-width: 0;
    padding: 0;
    margin: 0 1 0 0;
    border: none;
    background: $primary-darken-2;
    color: auto 90%;
}

#actions Button:hover {
    background: $accent;
    color: auto 90%;
}

#actions #actions-spacer {
    width: 1fr;
    height: 1;
    background: transparent;
}

#actions #btn-help {
    margin-right: 0;
}

#actions Button:disabled {
    background: $panel;
    color: $text-muted;
    opacity: 40%;
}

/* -- responsive tiers ----------------------------------------------------- */

.-narrow #btn-quit {
    display: none;
}

.-compact #actions Button {
    padding: 0;
    margin: 0 1 0 0;
}

.-narrow #actions Button {
    margin: 0;
}

.-compact .group-header {
    margin-top: 0;
}

.-tiny #app-header,
.-tiny #status {
    display: none;
}

.-tiny #btn-hide,
.-tiny #btn-theme,
.-tiny #btn-quit {
    display: none;
}

.-tiny .group-header,
.-tiny .todo-row {
    padding: 0;
    margin-top: 0;
}

.-tiny #todo-list {
    scrollbar-size-vertical: 0;
}

.-tiny #actions {
    padding: 0 1;
}

.-tiny #actions Button {
    padding: 0;
    margin: 0;
}

.-tiny #btn-help {
    width: 1;
    min-width: 1;
    padding: 0;
    margin-right: 0;
}

.-micro #actions {
    display: none;
}

.-nano #views,
.-nano #view-bar {
    display: none;
}

/* -- transparent background ----------------------------------------------- */

App.-transparent {
    background: ansi_default;
}

Screen.-transparent {
    background: ansi_default;
}

Screen.-transparent #views,
Screen.-transparent #view-bar,
Screen.-transparent #todo-list,
Screen.-transparent #status,
Screen.-transparent #actions,
Screen.-transparent .group-header {
    background: ansi_default;
}

Screen.-transparent .group-header:hover {
    background: $boost;
}

/* -- modals --------------------------------------------------------------- */

ModalScreen {
    align: center middle;
    background: $background 60%;
}

.dialog {
    width: 64;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $border;
    background: $surface;
}

.dialog-title {
    width: 100%;
    height: 1;
    color: $text;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.dialog Input {
    width: 100%;
    height: 1;
    margin-top: 1;
    padding: 0 1;
    border: none;
    background: $panel;
}

.dialog-buttons {
    height: 1;
    margin-top: 1;
}

.dialog-buttons Button {
    height: 1;
    min-width: 0;
    margin: 0 1 0 0;
    padding: 0 1;
    border: none;
}

.dialog-buttons Button:hover {
    background: $accent;
    color: auto 90%;
}

.group-dialog {
    width: 64;
    max-width: 92%;
}

#group-options {
    height: auto;
    max-height: 14;
    padding: 0;
    border: none;
    background: transparent;
}

#group-options .option-list--option {
    height: 1;
    padding: 0 1;
}

.-tiny .dialog {
    width: 100%;
    max-width: 100%;
    max-height: 100%;
    padding: 0 1;
    border: none;
}

.-tiny .dialog-title {
    margin-top: 0;
}

.-tiny .dialog Input {
    margin-top: 0;
}

.-tiny .dialog-buttons {
    margin-top: 0;
}

.-tiny .group-dialog {
    height: 100%;
}

.-tiny #group-options {
    height: 1fr;
    max-height: 100%;
}

.-nano .dialog-title {
    display: none;
}

.-tiny {
    background: $surface;
}

/* -- todo editor ---------------------------------------------------------- */

.todo-dialog {
    width: 68;
    max-width: 94%;
}

.todo-dialog .field-label {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#todo-description {
    width: 100%;
    height: 6;
    margin-top: 0;
    padding: 0 1;
    border: none;
    background: $panel;
    scrollbar-size-vertical: 1;
}

#todo-description.-invalid {
    background-tint: $error 20%;
}

.todo-dialog .form-error {
    display: none;
    width: 100%;
    height: 1;
    color: $error;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.todo-dialog .form-error.-visible {
    display: block;
}

.-compact .todo-dialog {
    padding: 0 1;
}

.-compact .todo-dialog .field-label {
    display: none;
}

.-compact .todo-dialog .dialog-buttons {
    margin-top: 0;
}

.-compact #todo-description {
    height: 3;
}

.-tiny .todo-dialog {
    height: 100%;
}

.-tiny #todo-description {
    height: 1fr;
}

.-nano #todo-description {
    display: none;
}

/* At the shortest sizes the dialog title makes way for the fields. */
.-micro .todo-dialog .dialog-title {
    display: none;
}

.-micro .todo-dialog .form-error {
    display: none;
}

/* Keep the buttons on screen when an inline error adds a row. */
.-tiny .todo-dialog.-error .dialog-title {
    display: none;
}

/* -- theme picker --------------------------------------------------------- */

.theme-dialog {
    width: 54;
    max-width: 92%;
}

#theme-options {
    height: auto;
    max-height: 14;
    padding: 0;
    border: none;
    background: transparent;
}

#theme-options .option-list--option {
    height: 1;
    padding: 0 1;
}

.-tiny .theme-dialog {
    height: 100%;
}

.-tiny #theme-options {
    height: 1fr;
    max-height: 100%;
}

/* -- help window ---------------------------------------------------------- */

.help-dialog {
    width: 74;
    max-width: 94%;
    height: 80%;
    max-height: 32;
}

.help-intro {
    width: 100%;
    height: 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#help-list {
    width: 100%;
    height: 1fr;
    padding: 0;
    border: none;
    background: transparent;
    scrollbar-size-vertical: 1;
}

.help-section {
    width: 100%;
    height: 1;
    margin-top: 1;
    color: $accent;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.help-row {
    width: 100%;
    height: 1;
}

.help-key {
    width: 22;
    height: 1;
    padding: 0 1;
    background: $primary-darken-2;
    color: auto 90%;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.help-desc {
    width: 1fr;
    height: 1;
    padding: 0 0 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.help-note {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding: 0 1;
    color: $text-muted;
    text-style: italic;
    text-wrap: wrap;
}

.-compact .help-row {
    layout: vertical;
    height: auto;
    margin-bottom: 1;
}

.-compact .help-key,
.-compact .help-desc {
    width: 100%;
}

.-compact .help-desc {
    height: auto;
    padding: 0;
    text-wrap: wrap;
}

.-compact .help-intro {
    height: auto;
    text-wrap: wrap;
}

.-tiny .help-dialog {
    height: 100%;
    max-height: 100%;
}

.-tiny .help-intro {
    display: none;
}
