Screen {
    background: $surface;
    color: $text;
}

/* -- header --------------------------------------------------------------- */

#app-header {
    height: 1;
    padding: 0 1;
    background: $primary;
    color: auto 90%;
}

#app-header Static {
    height: 1;
    padding: 0;
    background: transparent;
}

#app-title {
    width: auto;
    text-style: bold;
}

#app-stats {
    width: 1fr;
    text-align: right;
    color: auto 70%;
}

/* -- view tabs ------------------------------------------------------------ */

#views {
    height: 1;
    background: $panel;
}

#views Underline {
    display: none;
}

#views #tabs-list-bar {
    height: 1;
}

#views Tab {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    background: transparent;
    pointer: pointer;
}

#views Tab:hover {
    background: $boost;
}

#views Tab.-active {
    color: auto 90%;
    background: $accent;
    text-style: bold;
}

/* -- list ----------------------------------------------------------------- */

#todo-list {
    height: 1fr;
    padding: 0;
    scrollbar-size-vertical: 1;
}

.todo-row {
    width: 100%;
    height: 1;
    padding: 0 1;
    color: $text;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    pointer: pointer;
}

.todo-row:hover {
    background: $boost;
}

.todo-row.-done {
    color: $text-muted;
    text-style: strike;
}

.todo-row.-selected {
    background: $block-cursor-background;
    color: $block-cursor-foreground;
    text-style: $block-cursor-text-style;
}

.todo-row.-selected.-done {
    color: $block-cursor-foreground;
}

.group-header {
    width: 100%;
    height: 1;
    margin-top: 1;
    padding: 0 1;
    color: $text-muted;
    background: $panel;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    pointer: pointer;
}

.group-header.-first {
    margin-top: 0;
}

.group-header:hover {
    background: $boost;
}

.empty-state {
    width: 100%;
    height: 100%;
    padding: 0 1;
    color: $text-muted;
    content-align: center middle;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* -- bottom chrome -------------------------------------------------------- */

#status {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    background: $surface;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#status.-error {
    color: $error;
}

#actions {
    height: 1;
    padding: 0 1;
    background: $panel;
}

#actions Button {
    height: 1;
    min-width: 0;
    padding: 0 1;
    margin: 0 1 0 0;
    border: none;
    background: $primary-darken-2;
    color: auto 90%;
}

#actions Button:hover {
    background: $accent;
    color: auto 90%;
}

#actions Button:disabled {
    background: $panel;
    color: $text-muted;
    opacity: 40%;
}

#help {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    background: $surface;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* -- responsive tiers ----------------------------------------------------- */

.-compact #help {
    display: none;
}

.-narrow #btn-quit {
    display: none;
}

.-compact #actions Button {
    padding: 0;
    margin: 0 1 0 0;
}

.-compact .group-header {
    margin-top: 0;
}

.-tiny #app-header,
.-tiny #status,
.-tiny #help {
    display: none;
}

.-tiny #btn-hide,
.-tiny #btn-theme,
.-tiny #btn-quit {
    display: none;
}

.-tiny .group-header,
.-tiny .todo-row {
    padding: 0;
    margin-top: 0;
}

.-tiny #todo-list {
    scrollbar-size-vertical: 0;
}

.-tiny #actions Button {
    padding: 0;
    margin: 0 1 0 0;
}

.-micro #actions {
    display: none;
}

.-nano #views {
    display: none;
}

/* -- transparent background ----------------------------------------------- */

App.-transparent {
    background: ansi_default;
}

Screen.-transparent {
    background: ansi_default;
}

Screen.-transparent #views,
Screen.-transparent #status,
Screen.-transparent #help,
Screen.-transparent #actions,
Screen.-transparent .group-header {
    background: ansi_default;
}

Screen.-transparent .group-header:hover {
    background: $boost;
}

/* -- modals --------------------------------------------------------------- */

ModalScreen {
    align: center middle;
    background: $background 60%;
}

.dialog {
    width: 64;
    max-width: 90%;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $border;
    background: $surface;
}

.dialog-title {
    width: 100%;
    height: 1;
    color: $text;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.dialog Input {
    width: 100%;
    height: 1;
    margin-top: 1;
    padding: 0 1;
    border: none;
    background: $panel;
}

.dialog-buttons {
    height: 1;
    margin-top: 1;
}

.dialog-buttons Button {
    height: 1;
    min-width: 0;
    margin: 0 1 0 0;
    padding: 0 1;
    border: none;
}

.dialog-buttons Button:hover {
    background: $accent;
    color: auto 90%;
}

.group-dialog {
    width: 64;
    max-width: 92%;
}

#group-options {
    height: auto;
    max-height: 14;
    padding: 0;
    border: none;
    background: transparent;
}

#group-options .option-list--option {
    height: 1;
    padding: 0 1;
}

.-tiny .dialog {
    width: 100%;
    max-width: 100%;
    max-height: 100%;
    padding: 0 1;
    border: none;
}

.-tiny .dialog-title {
    margin-top: 0;
}

.-tiny .dialog Input {
    margin-top: 0;
}

.-tiny .dialog-buttons {
    margin-top: 0;
}

.-tiny .group-dialog {
    height: 100%;
}

.-tiny #group-options {
    height: 1fr;
    max-height: 100%;
}

.-tiny {
    background: $surface;
}

/* -- theme picker --------------------------------------------------------- */

.theme-dialog {
    width: 54;
    max-width: 92%;
}

#theme-options {
    height: auto;
    max-height: 14;
    padding: 0;
    border: none;
    background: transparent;
}

#theme-options .option-list--option {
    height: 1;
    padding: 0 1;
}

.-tiny .theme-dialog {
    height: 100%;
}

.-tiny #theme-options {
    height: 1fr;
    max-height: 100%;
}
